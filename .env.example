# Public Firebase web configuration. These values are not administrator secrets.
# Leave disabled for the fully local demo. Enable only your explicitly selected project.
VITE_FIREBASE_ENABLED=false
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
