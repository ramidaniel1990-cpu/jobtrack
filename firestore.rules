rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function text(value, limit) { return value is string && value.size() <= limit; }
    function identifier(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,128}$'); }
    function exact(value, fields) { return value is map && value.keys().hasAll(fields) && value.keys().hasOnly(fields); }
    // Pad missing positions once, then validate every slot with a string-only operation.
    // matches() rejects non-string receivers; its bounded pattern also checks length.
    // This preserves all 20 checks without exceeding the 1,000-expression budget.
    function stringList(values) {
      let padded = values.concat(['', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '']);
      return values is list && values.size() <= 20
        && padded[0].matches('^[\\s\\S]{0,128}$')
        && padded[1].matches('^[\\s\\S]{0,128}$')
        && padded[2].matches('^[\\s\\S]{0,128}$')
        && padded[3].matches('^[\\s\\S]{0,128}$')
        && padded[4].matches('^[\\s\\S]{0,128}$')
        && padded[5].matches('^[\\s\\S]{0,128}$')
        && padded[6].matches('^[\\s\\S]{0,128}$')
        && padded[7].matches('^[\\s\\S]{0,128}$')
        && padded[8].matches('^[\\s\\S]{0,128}$')
        && padded[9].matches('^[\\s\\S]{0,128}$')
        && padded[10].matches('^[\\s\\S]{0,128}$')
        && padded[11].matches('^[\\s\\S]{0,128}$')
        && padded[12].matches('^[\\s\\S]{0,128}$')
        && padded[13].matches('^[\\s\\S]{0,128}$')
        && padded[14].matches('^[\\s\\S]{0,128}$')
        && padded[15].matches('^[\\s\\S]{0,128}$')
        && padded[16].matches('^[\\s\\S]{0,128}$')
        && padded[17].matches('^[\\s\\S]{0,128}$')
        && padded[18].matches('^[\\s\\S]{0,128}$')
        && padded[19].matches('^[\\s\\S]{0,128}$');
    }
    function isoDate(value) {
      return text(value, 40) && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
    }
    function criterion(value) {
      return exact(value, ['value', 'required']) && text(value.value, 1000) && value.required is bool;
    }
    function filters(value) {
      return exact(value, ['keywords', 'technologies', 'experience', 'location', 'modality', 'employment', 'languages', 'minSalary', 'maxAgeDays', 'excludedWords'])
        && criterion(value.keywords) && criterion(value.technologies) && criterion(value.experience)
        && criterion(value.location) && criterion(value.modality) && criterion(value.employment)
        && criterion(value.languages) && criterion(value.minSalary) && criterion(value.maxAgeDays) && criterion(value.excludedWords)
        && value.minSalary.value.size() <= 32
        && (value.minSalary.value.matches('^\\s*$') || (value.minSalary.value.matches('^\\s*([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]{1,3})?\\s*$') && float(value.minSalary.value) >= 0 && float(value.minSalary.value) <= 1000000000))
        && (value.maxAgeDays.value.matches('^\\s*$') || (value.maxAgeDays.value.matches('^[0-9]{1,5}$') && int(value.maxAgeDays.value) <= 36500));
    }
    function schedule(value) {
      return exact(value, ['frequency', 'time', 'timezone', 'weekday'])
        && value.frequency in ['manual', 'daily', 'weekly']
        && text(value.time, 10) && text(value.timezone, 100) && text(value.weekday, 10)
        && (value.frequency == 'manual' || (value.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && value.timezone.matches('^[A-Za-z_+-]+(/[A-Za-z0-9_+-]+)*$')))
        && (value.frequency != 'weekly' || value.weekday in ['1', '2', '3', '4', '5', '6', '7']);
    }
    function search(value, id) {
      return value is map
        && value.keys().hasAll(['id', 'name', 'filters', 'currency', 'schedule', 'paused', 'createdAt'])
        && value.keys().hasOnly(['id', 'name', 'filters', 'currency', 'schedule', 'paused', 'createdAt', 'lastRunAt'])
        && identifier(value.id) && value.id == id
        && text(value.name, 80) && value.name.matches('.*[^\\s].*')
        && filters(value.filters) && value.currency is string && value.currency.matches('^[A-Z]{3}$')
        && schedule(value.schedule) && value.paused is bool && isoDate(value.createdAt)
        && (!('lastRunAt' in value) || isoDate(value.lastRunAt));
    }
    function offer(value, id) {
      return value is map
        && value.keys().hasAll(['id', 'title', 'company', 'location', 'modality', 'technologies', 'experience', 'employment', 'languages', 'currency', 'publishedAt', 'description', 'explanation', 'score', 'searchIds'])
        && value.keys().hasOnly(['id', 'title', 'company', 'location', 'modality', 'technologies', 'experience', 'employment', 'languages', 'salary', 'currency', 'publishedAt', 'description', 'explanation', 'score', 'searchIds'])
        && identifier(value.id) && value.id == id
        && text(value.title, 200) && text(value.company, 200) && text(value.location, 300)
        && text(value.modality, 100) && text(value.experience, 100) && text(value.employment, 100)
        && stringList(value.technologies) && stringList(value.languages) && stringList(value.searchIds)
        && value.currency is string && value.currency.matches('^[A-Z]{3}$')
        && isoDate(value.publishedAt) && text(value.description, 10000) && text(value.explanation, 10000)
        && value.score is number && value.score >= 0 && value.score <= 100
        && (!('salary' in value) || (value.salary is number && value.salary >= 0 && value.salary <= 1000000000));
    }
    function decision(value, id) {
      return exact(value, ['offerId', 'status']) && identifier(value.offerId) && value.offerId == id && value.status in ['saved', 'discarded'];
    }
    function envelope(value) {
      return exact(value, ['payload', 'updatedAt']) && value.updatedAt is timestamp && value.updatedAt == request.time;
    }
    match /users/{uid}/searches/{id} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && envelope(request.resource.data) && search(request.resource.data.payload, id);
      allow delete: if owns(uid);
    }
    match /users/{uid}/offers/{id} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && envelope(request.resource.data) && offer(request.resource.data.payload, id);
      allow delete: if owns(uid);
    }
    match /users/{uid}/decisions/{id} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && envelope(request.resource.data) && decision(request.resource.data.payload, id);
      allow delete: if owns(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
